{
    "$schema": "gigischema.json",
    "name": "FastBokeh",
    "version": "1.0",
    "variables": [
        {
            "name": "FocusDistance",
            "comment": "Distance of focus in scene units (cm)",
            "type": "Float",
            "dflt": "45",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "1",
                "max": "60",
                "step": "1"
            },
            "UIGroup": "LensSimulationDoF"
        },
        {
            "name": "RenderPinhole",
            "type": "Bool",
            "dflt": "0",
            "visibility": "User",
            "UIGroup": "Pinhole"
        },
        {
            "name": "RenderThinLensDoF",
            "type": "Bool",
            "dflt": "0",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "RenderLensSimulationDoF",
            "type": "Bool",
            "dflt": "0",
            "visibility": "User",
            "UIGroup": "LensSimulationDoF"
        },
        {
            "name": "RenderBokehConfig",
            "type": "Bool",
            "dflt": "0",
            "visibility": "User",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "Reset",
            "type": "Bool",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Button"
            }
        },
        {
            "name": "RenderSize",
            "type": "Uint2",
            "dflt": "512, 512",
            "visibility": "User"
        },
        {
            "name": "Accumulate",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "Animate",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "HeliosApertureStop",
            "type": "Uint",
            "dflt": "6",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "6",
                "step": "1"
            },
            "UIGroup": "LensSimulationDoF"
        },
        {
            "name": "ToggleChromaticAberration",
            "type": "Bool",
            "dflt": "0",
            "visibility": "User",
            "UIGroup": "LensSimulationDoF"
        },
        {
            "name": "MaterialSet",
            "type": "Int",
            "dflt": "None",
            "visibility": "User",
            "Enum": "MaterialSets",
            "UIGroup": "Scene"
        },
        {
            "name": "SamplesPerPixelPerFrame",
            "type": "Uint",
            "dflt": "1",
            "visibility": "User"
        },
        {
            "name": "JitterPixels",
            "comment": "Provides Antialiasing",
            "type": "Int",
            "dflt": "PerPixel",
            "visibility": "User",
            "Enum": "PixelJitterType"
        },
        {
            "name": "DepthNearPlane",
            "type": "Float",
            "dflt": "0.1",
            "visibility": "Host"
        },
        {
            "name": "CameraPos",
            "type": "Float3",
            "visibility": "Host"
        },
        {
            "name": "RayPosNormalNudge",
            "type": "Float",
            "dflt": "0.1f",
            "visibility": "Host"
        },
        {
            "name": "CameraChanged",
            "type": "Bool",
            "visibility": "Host"
        },
        {
            "name": "InvViewProjMtx",
            "type": "Float4x4",
            "visibility": "Host"
        },
        {
            "name": "MouseState",
            "type": "Float4",
            "visibility": "Host"
        },
        {
            "name": "FrameIndex",
            "type": "Uint",
            "transient": true
        },
        {
            "name": "NumBounces",
            "comment": "How many bounces the rays are allowed",
            "type": "Uint",
            "dflt": "4",
            "visibility": "User"
        },
        {
            "name": "AlbedoMode",
            "comment": "if true, returns albedo * AlbedoModeAlbedoMultiplier + emissive at primary hit",
            "type": "Bool",
            "dflt": "1.0f",
            "visibility": "User",
            "UIGroup": "Scene"
        },
        {
            "name": "AlbedoModeAlbedoMultiplier",
            "comment": "How much to multiply albedo by in albedo mode, to darken it or lighten it",
            "type": "Float",
            "dflt": "0.5f",
            "visibility": "User",
            "UIGroup": "Scene"
        },
        {
            "name": "LensRNGSource",
            "type": "Int",
            "dflt": "UniformCircleWhite",
            "visibility": "User",
            "Enum": "LensRNG",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "LensRNGExtend",
            "comment": "How to extend the noise textures",
            "type": "Int",
            "dflt": "None",
            "visibility": "User",
            "Enum": "NoiseTexExtends",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "JitterNoiseTextures",
            "comment": "The noise textures are 8 bit unorms. This adds a random value between -0.5/255 and +0.5/255 to fill in the unset bits with white noise.",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User"
        },
        {
            "name": "InvViewMtx",
            "type": "Float4x4",
            "visibility": "Host"
        },
        {
            "name": "ApertureRadius",
            "type": "Float",
            "dflt": "1.0f",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "AnamorphicScaling",
            "comment": "Defaults to 1.0, 1.0 for no anamorphic effects. Elongates the aperture, does not simulate anamorphic elements.",
            "type": "Float2",
            "dflt": "1.0f, 1.0f",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "PetzvalScaling",
            "comment": "Scales bokeh on each axis depending on screen position. Fakes the effect. Defaults to 1.0, 1.0 for no elongation.",
            "type": "Float2",
            "dflt": "1.0f, 1.0f",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "OcclusionSettings",
            "comment": "Pushes the bounding square of the lens outwards and clips against a unit circle. 1,1,1 means no occlusion. x is how far from the center of the screen to start moving the square. 0 is center, 1 is the corner.  y is how much to scale the lens bounding square by.  z is how far to move the square, as the pixel is farther from where the occlusion begins. Reasonable settings are 0, 0.1, 1.25.",
            "type": "Float3",
            "dflt": "1.0f, 1.0f, 1.0f",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "NoImportanceSampling",
            "comment": "If true, the FAST noise textures will not be used, and ",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "SkyColor",
            "type": "Float3",
            "dflt": "1.0f, 1.0f, 1.0f",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            },
            "UIGroup": "Scene"
        },
        {
            "name": "SkyBrightness",
            "type": "Float",
            "dflt": "10.0f",
            "visibility": "User",
            "UIGroup": "Scene"
        },
        {
            "name": "MaterialEmissiveMultiplier",
            "type": "Float",
            "dflt": "1.0f",
            "visibility": "User",
            "UIGroup": "Scene"
        },
        {
            "name": "SmallLightBrightness",
            "type": "Float",
            "dflt": "1.0f",
            "visibility": "User",
            "UIGroup": "SmallLights"
        },
        {
            "name": "SmallLightsColor",
            "type": "Float3",
            "dflt": "1.0f, 1.0f, 1.0f",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            },
            "UIGroup": "SmallLights"
        },
        {
            "name": "SmallLightsColorful",
            "comment": "If true, makes the small lights colorful, else makes them all the same color",
            "type": "Bool",
            "visibility": "User",
            "UIGroup": "SmallLights"
        },
        {
            "name": "SmallLightRadius",
            "type": "Float",
            "dflt": "1.0f",
            "visibility": "User",
            "UIGroup": "SmallLights"
        },
        {
            "name": "ConfigLightDistance",
            "comment": "distance of lights to camera in world units (cm)",
            "type": "Float",
            "dflt": "2000",
            "visibility": "User",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "ConfigLightCount",
            "comment": "the amount of lights rendered, 2D for grid, 1D for diagonal",
            "type": "Uint2",
            "visibility": "User",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "ConfigOnlyDiagonal",
            "comment": "render diagonal lights instead of grid",
            "type": "Bool",
            "dflt": "1",
            "visibility": "User",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "OnlyThisLightByIndex",
            "comment": "-1 is render all the lights, otherwise only light with according index is rendered",
            "type": "Int",
            "dflt": "-1",
            "visibility": "User",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "BokehConfigMode",
            "type": "Int",
            "dflt": "0",
            "visibility": "User",
            "Enum": "BokehConfigState",
            "UIGroup": "BokehConfig"
        },
        {
            "name": "FocalLength",
            "type": "Float",
            "dflt": "40",
            "visibility": "User",
            "UIGroup": "ThinLensDoF"
        },
        {
            "name": "DoGatherDoF",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User"
        },
        {
            "name": "DoDOFAccumulation",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User"
        },
        {
            "name": "SpatiallyVarying",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "FastDistortionGatherDoF",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "GatherDOFTapCount",
            "type": "Uint",
            "dflt": "20",
            "visibility": "User"
        }
    ],
    "shaders": [
        {
            "name": "RayGen",
            "fileName": "RT_exterior.hlsl",
            "type": "RTRayGen",
            "entryPoint": "RayGen",
            "resources": [
                {
                    "name": "PinholeOut",
                    "access": "UAV",
                    "type": "Texture",
                    "buffer": {
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "ThinlensOut",
                    "access": "UAV",
                    "type": "Texture",
                    "buffer": {
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "LensSimulationOut",
                    "access": "UAV",
                    "type": "Texture",
                    "buffer": {
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "BokehConfigOut",
                    "access": "UAV",
                    "type": "Texture",
                    "buffer": {
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "LinearDepth",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "Scene",
                    "access": "RTScene",
                    "type": "Buffer",
                    "buffer": {
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "VertexBuffer",
                    "access": "SRV",
                    "type": "Buffer",
                    "buffer": {
                        "typeStruct": {
                            "name": "VBStruct"
                        },
                        "PODAsStructuredBuffer": false
                    }
                }
            ],
            "samplers": [
                {
                    "name": "PointWrapSampler",
                    "filter": "MinMagMipPoint"
                },
                {
                    "name": "PointClampSampler",
                    "filter": "MinMagMipPoint",
                    "addressMode": "Clamp"
                },
                {
                    "name": "Linear",
                    "addressMode": "Border"
                }
            ]
        },
        {
            "name": "Miss",
            "fileName": "RT_exterior.hlsl",
            "type": "RTMiss",
            "entryPoint": "Miss",
            "copyFile": false
        },
        {
            "name": "ClosestHit",
            "fileName": "RT_exterior.hlsl",
            "type": "RTClosestHit",
            "entryPoint": "ClosestHit",
            "copyFile": false
        },
        {
            "name": "ShaderToHuman",
            "fileName": "s2h\\include\\s2h.hlsl",
            "type": "Count",
            "entryPoint": ""
        },
        {
            "name": "S2H Scatter",
            "fileName": "s2h\\include\\s2h_scatter.hlsl",
            "type": "Count",
            "entryPoint": ""
        }
    ],
    "structs": [
        {
            "name": "VBStruct",
            "forceHostVisible": true,
            "fields": [
                {
                    "name": "position",
                    "type": "Float3",
                    "semantic": "Position"
                },
                {
                    "name": "normal",
                    "type": "Float3",
                    "semantic": "Normal"
                },
                {
                    "name": "tangent",
                    "type": "Float4",
                    "semantic": "Tangent"
                },
                {
                    "name": "UV",
                    "type": "Float2",
                    "semantic": "UV"
                },
                {
                    "name": "materialID",
                    "type": "Uint",
                    "semantic": "MaterialID"
                }
            ]
        }
    ],
    "fileCopies": [
        {
            "fileName": "LensSimulation.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "CameraLensData.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "PCG.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "IndexToColor.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "LDSShuffler.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "Assets\\Exterior\\exterior.bin",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Exterior\\exterior.mtl",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Exterior\\exterior.obj",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Interior\\countcsv.py",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Interior\\Interior.bin",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Interior\\interior.mtl",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\Interior\\interior.obj",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "Assets\\readme.txt",
            "type": "Asset",
            "binary": true
        },
        {
            "fileName": "common_structs.hlsli",
            "type": "Shader"
        },
        {
            "fileName": "DrawBokehConfig.hlsli",
            "type": "Shader"
        }
    ],
